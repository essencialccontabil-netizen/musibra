{
  "name": "musibras",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build && node scripts/build-server.mjs",
    "start": "NODE_ENV=production node dist-server/index.js",
    "preview": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"vite preview --host 127.0.0.1 --port 4173\"",
    "lint": "oxlint"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "concurrently": "^10.0.7",
    "esbuild": "^0.27.0",
    "hono": "^4.13.23",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.94.0",
    "typescript": "~7.0.2",
    "vite": "^8.4.0"
  }
}
